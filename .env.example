# Copy to .env (bootstrap/vm-setup.sh does this for you and fills in the values).

# The single address every client can reach. This is the VM's internal VPC IP
# (reserve it as static in GCP). Redis Cluster and Kafka advertise it to clients.
HOST_IP=10.128.0.5

# ---- Redis Cluster ----
REDIS_IMAGE=redis:7.4.2
REDIS_PASSWORD=change-me
REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=384m
REDISINSIGHT_IMAGE=redis/redisinsight:2.60.0

# ---- Kafka (KRaft) ----
KAFKA_IMAGE=apache/kafka:4.0.0
# 22-char base64url id, generated once and never changed:
#   openssl rand -base64 16 | tr '+/' '-_' | tr -d '='
KAFKA_CLUSTER_ID=REPLACE_ME_22_CHARS_XX
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
KAFKA_MEM_LIMIT=1g
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.2.0
